#!/usr/bin/env bash
# Pre-commit hook: block commits that contain secrets, account numbers, or
# words from the private blocked-words list.
# Adapted from gitleaks' example scripts/pre-commit.py, using the 8.x command.
# Enable after a fresh clone with: git config core.hooksPath .githooks
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is not installed, so this commit is blocked."
  echo "Install it with: brew install gitleaks"
  exit 1
fi

repo_root="$(git rev-parse --show-toplevel)"
if ! gitleaks git --pre-commit --staged --redact --verbose \
    --config "$repo_root/.gitleaks.toml" "$repo_root"; then
  echo
  echo "Commit blocked: gitleaks found possible secrets or account numbers above."
  echo "Remove them from the staged files, or if it's a false positive, add a"
  echo "narrow allowlist entry to .gitleaks.toml (never disable a rule)."
  exit 1
fi

# Blocked words: reads <data folder>/blocked_words.txt, prints only file and
# line number on a match, and blocks the commit if the list is missing.
python_bin="$repo_root/.venv/bin/python"
[ -x "$python_bin" ] || python_bin="$(command -v python3 || true)"
if [ -z "$python_bin" ]; then
  echo "Python not found, so the blocked-words check can't run. Commit blocked."
  exit 1
fi
"$python_bin" -I "$repo_root/.githooks/blocked_words.py"
